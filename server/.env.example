# GroundOps Server Environment Configuration

NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/groundops

# JWT Authentication
JWT_ACCESS_SECRET=groundops_dev_jwt_access_secret_key_32_chars_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=groundops_dev_jwt_refresh_secret_key_32_chars_min!
JWT_REFRESH_EXPIRES_IN=7d

# Invitation Expiry (hours)
INVITATION_TOKEN_EXPIRES_HOURS=72

# Admin Web Portal URL (where acceptance links point)
FRONTEND_URL=http://localhost:3000

# Nodemailer / SMTP settings (Leave blank for in-memory simulated email logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GroundOps Ops <no-reply@groundops.internal>

# Default Admin Seed
ADMIN_EMAIL=admin@groundops.demo
ADMIN_PASSWORD=Admin@123456
